{
    "_comment_1": "------------------------------------------------------------",
    "_comment_2": "FetchLog Database Configuration",
    "_comment_3": "------------------------------------------------------------",
    "_comment_4": "db_type: which database backend to use for LOG STORAGE.",
    "_comment_5": "  'sqlite'      - local file-based database (default, no setup needed)",
    "_comment_6": "  'postgresql'  - remote PostgreSQL server",
    "_comment_7": "",
    "_comment_8": "When db_type is 'sqlite', only sqlite_path is used.",
    "_comment_9": "When db_type is 'postgresql', the host/port/dbname/user/password/schema",
    "_comment_10": "  fields are used and sqlite_path is ignored.",
    "_comment_11": "",
    "_comment_12": "schema: the PostgreSQL schema to create LOG tables in (default: fetchlog).",
    "_comment_13": "  The schema is created automatically if it does not exist.",
    "_comment_14": "  All tables, indexes, etc. are created on first startup.",
    "_comment_15": "------------------------------------------------------------",

    "db_type": "sqlite",

    "sqlite_path": "logs.db",

    "host": "localhost",
    "port": 5432,
    "dbname": "fetchlog",
    "user": "fetchlog",
    "password": "your_password_here",
    "schema": "fetchlog",

    "_auth_comment_1": "------------------------------------------------------------",
    "_auth_comment_2": "Authentication - shared single-sign-on with Leash / 321Theater",
    "_auth_comment_3": "------------------------------------------------------------",
    "_auth_comment_4": "Sessions are stored server-side in <shared_schema>.app_sessions in",
    "_auth_comment_5": "  PostgreSQL; the browser cookie holds only an opaque random session id.",
    "_auth_comment_6": "Users are read (READ-ONLY) from <shared_schema>.users, which is owned and",
    "_auth_comment_7": "  created by 321Theater. Only users whose 'role' is in allowed_roles may",
    "_auth_comment_8": "  sign in - FetchLog defaults to admins only.",
    "_auth_comment_9": "Auth ALWAYS uses PostgreSQL, even when db_type above is 'sqlite'. The",
    "_auth_comment_10": "  host/port/dbname/user/password below MUST point at the database that",
    "_auth_comment_11": "  contains the 'shared' schema (the sibling apps' database). Any field left",
    "_auth_comment_12": "  out inherits the top-level PostgreSQL field above.",
    "_auth_comment_13": "cookie_name/cookie_domain must match the sibling apps so the browser sends",
    "_auth_comment_14": "  the same cookie to all of them (serve them on one host or a shared parent",
    "_auth_comment_15": "  domain, e.g. cookie_domain '.example.com'). Set enabled=false to disable",
    "_auth_comment_16": "  the login gate entirely (development only).",
    "_auth_comment_17": "------------------------------------------------------------",
    "auth": {
        "enabled": true,
        "host": "192.168.1.50",
        "port": 5432,
        "dbname": "theater321",
        "user": "fetchlog",
        "password": "your_password_here",
        "shared_schema": "shared",
        "allowed_roles": ["admin"],
        "cookie_name": "session",
        "cookie_domain": null,
        "cookie_secure": false,
        "cookie_samesite": "lax",
        "session_lifetime_hours": 12
    }
}
